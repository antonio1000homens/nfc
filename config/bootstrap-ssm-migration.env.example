# Copy to config/bootstrap-ssm-migration.env (gitignored) and fill in local values.
# Never commit the populated file.

AWS_PROFILE=
AWS_REGION=eu-west-2
CODE_BUCKET=
DEPLOYMENT_ROLE_NAME=GitHubActionsNfcDeployRole
STACK_NAME=nfc
S3_PREFIX=nfc
GH_ENVIRONMENT=production

# Bitwarden Secrets Manager machine-account token used only by the one-time
# local migration. Uncomment this line in the gitignored local config and set
# the real token, or export BWS_ACCESS_TOKEN in your shell before running.
# BWS_ACCESS_TOKEN=

# Optional: supply the non-secret spreadsheet ID directly instead of reading it
# from Bitwarden during the one-time migration.
SPREADSHEET_ID=

# Optional Bitwarden secret-ID overrides. Keep real UUIDs only in the gitignored
# local config. When blank, the bootstrap script discovers by logical key name.
BW_CF_NFC_API_KEY=
BW_AWS2022_AWS_SLACK_BOT=
BW_NFC_GOOGLE_SA=
BW_NFC_SPREADSHEET_ID=
